{
	"name": "uddns",
	"version": "3.1.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "bun scripts/deploy.ts",
		"setup": "bun scripts/setup.ts",
		"cf-typegen": "wrangler types",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
		"check": "bun run typecheck && bun run lint && bun run format:check",
		"check:all": "bun run check && bun run test:run",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.20.1",
		"@eslint/js": "^10.0.0",
		"@types/bun": "1.3.14",
		"@types/node": "26.1.2",
		"@vitest/coverage-istanbul": "4.1.10",
		"comment-json": "5.0.0",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"jiti": "^2.7.0",
		"lefthook": "^2.1.10",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vitest": "4.1.10",
		"wrangler": "4.118.0"
	},
	"dependencies": {
		"cloudflare": "7.0.0"
	},
	"overrides": {
		"undici": "7.29.0"
	}
}
